# Production build config. Vite loads this automatically for `npm run build`
# (and therefore for the GitHub Pages workflow) -- no repo variable, no manual
# step, nothing to forget.
#
# This is the deployed Cloud Run search service. It is a PUBLIC URL, not a
# secret, so it is committed deliberately. To repoint the frontend at a
# different backend, edit this line and push.
#
# The deterministic hostname is used rather than the random *.a.run.app one
# because it is derived from service name + project number + region, so it
# survives deleting and recreating the service.
VITE_API_BASE=https://tmu-case-db-777191320769.northamerica-northeast2.run.app

# Feedback page: OFF in production until the submission path is finished. The
# form currently builds a mailto: against a placeholder address, so a real
# submission would go nowhere. The component and its route stay in the codebase
# and remain fully usable in `npm run dev` -- only production hides them.
#
# To make it live: delete this line (or set it to true) and put a real address
# in src/components/Feedback.tsx.
VITE_FEEDBACK_ENABLED=false

# MCP connector card on the Dataset page: ON.
#
# The gate was here so the card could not publish a connector URL before the
# endpoint answered. That condition is now met — mcp_server.asgi_app() is mounted
# in server/app.py and deployed, and POST /mcp/ returns 200 with a session id on
# the live service. Leaving this at false is what kept the card out of the bundle
# entirely (Vite tree-shakes the disabled branch, so it was never hidden CSS —
# it was never compiled).
#
# Set VITE_MCP_ENABLED=false again if the endpoint ever comes down.
